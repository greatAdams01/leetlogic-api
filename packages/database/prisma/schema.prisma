generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum Capability {
  BUYER
  SELLER
}

enum VerificationStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum DocumentType {
  NIN_SLIP
  VOTER_CARD
  DRIVERS_LICENSE
  PASSPORT
}

enum ReviewDecision {
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum AdminStatus {
  INVITED
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SessionSubject {
  CUSTOMER
  ADMIN
}

enum OtpPurpose {
  CUSTOMER_LOGIN
  ADMIN_LOGIN
}

enum OtpProvider {
  CONSOLE
  TERMII
  AFRICAS_TALKING
}

enum OtpOutcome {
  REQUESTED
  SENT
  SEND_FAILED
  VERIFIED
  INVALID
  EXPIRED
  RATE_LIMITED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD_OUT
  REJECTED
  ARCHIVED
}

enum ShippingScope {
  LOCAL
  NATIONWIDE
}

enum MediaType {
  IMAGE
  VOICE_NOTE
}

enum MediaStatus {
  PENDING
  READY
  FAILED
}

enum InventoryMovementType {
  INCREASE
  DECREASE
  RESERVE
  RELEASE
  SALE
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  phoneE164       String           @unique @map("phone_e164")
  phoneVerifiedAt DateTime?        @map("phone_verified_at") @db.Timestamptz(6)
  status          UserStatus       @default(ACTIVE)
  preferredLocale String           @default("en") @map("preferred_locale") @db.VarChar(10)
  lastLoginAt     DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  profile         UserProfile?
  capabilities    UserCapability[]
  addresses       Address[]
  sessions        Session[]
  farmerProfile   FarmerProfile?

  @@map("users")
}

model UserCapability {
  userId     String     @map("user_id") @db.Uuid
  capability Capability
  grantedAt  DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, capability])
  @@map("user_capabilities")
}

model UserProfile {
  userId          String  @id @map("user_id") @db.Uuid
  fullName        String? @map("full_name") @db.VarChar(120)
  displayName     String? @map("display_name") @db.VarChar(80)
  avatarObjectKey String? @map("avatar_object_key") @db.VarChar(500)
  email           String? @db.VarChar(254)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Address {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  label             String?         @db.VarChar(60)
  countryCode       String          @default("NG") @map("country_code") @db.Char(2)
  state             String          @db.VarChar(80)
  lga               String          @db.VarChar(80)
  ward              String?         @db.VarChar(100)
  city              String          @db.VarChar(100)
  line1             String          @db.VarChar(180)
  line2             String?         @db.VarChar(180)
  landmark          String?         @db.VarChar(180)
  postalCode        String?         @map("postal_code") @db.VarChar(20)
  latitude          Decimal?        @db.Decimal(9, 6)
  longitude         Decimal?        @db.Decimal(9, 6)
  isDefaultDelivery Boolean         @default(false) @map("is_default_delivery")
  isDefaultFarm     Boolean         @default(false) @map("is_default_farm")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmerProfiles    FarmerProfile[]
  listings          Listing[]

  @@index([userId])
  @@map("addresses")
}

model Session {
  id               String         @id @default(uuid()) @db.Uuid
  subject          SessionSubject
  userId           String?        @map("user_id") @db.Uuid
  adminId          String?        @map("admin_id") @db.Uuid
  tokenFamilyId    String         @map("token_family_id") @db.Uuid
  refreshTokenHash String         @unique @map("refresh_token_hash") @db.Char(64)
  deviceId         String         @map("device_id") @db.VarChar(128)
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(6)
  replacedById     String?        @map("replaced_by_id") @db.Uuid
  reuseDetectedAt  DateTime?      @map("reuse_detected_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime?      @map("last_used_at") @db.Timestamptz(6)
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin            AdminAccount?  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenFamilyId])
  @@index([userId, deviceId])
  @@index([adminId, deviceId])
  @@map("sessions")
}

model OtpEvent {
  id                String      @id @default(uuid()) @db.Uuid
  provider          OtpProvider
  purpose           OtpPurpose
  maskedDestination String      @map("masked_destination") @db.VarChar(32)
  outcome           OtpOutcome
  attempts          Int         @default(0)
  ipAddress         String?     @map("ip_address") @db.Inet
  requestId         String      @map("request_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([requestId])
  @@map("otp_events")
}

model FarmerProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  farmName           String             @map("farm_name") @db.VarChar(160)
  farmType           String             @map("farm_type") @db.VarChar(80)
  description        String?            @db.Text
  primaryAddressId   String?            @map("primary_address_id") @db.Uuid
  verificationStatus VerificationStatus @default(DRAFT) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryAddress     Address?           @relation(fields: [primaryAddressId], references: [id], onDelete: SetNull)
  verificationCases  VerificationCase[]
  listings           Listing[]

  @@map("farmer_profiles")
}

model VerificationCase {
  id              String                 @id @default(uuid()) @db.Uuid
  farmerProfileId String                 @map("farmer_profile_id") @db.Uuid
  status          VerificationStatus     @default(DRAFT)
  submittedAt     DateTime?              @map("submitted_at") @db.Timestamptz(6)
  decidedAt       DateTime?              @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  farmerProfile   FarmerProfile          @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  documents       VerificationDocument[]
  evidence        FarmEvidence[]
  reviews         VerificationReview[]

  @@index([status, submittedAt])
  @@map("verification_cases")
}

model VerificationDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  verificationCaseId String             @map("verification_case_id") @db.Uuid
  documentType       DocumentType       @map("document_type")
  encryptedObjectKey String             @map("encrypted_object_key") @db.VarChar(1000)
  mimeType           String             @map("mime_type") @db.VarChar(100)
  checksumSha256     String             @map("checksum_sha256") @db.Char(64)
  referenceLastFour  String?            @map("reference_last_four") @db.VarChar(4)
  reviewStatus       VerificationStatus @default(DRAFT) @map("review_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  verificationCase   VerificationCase   @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model FarmEvidence {
  id                 String           @id @default(uuid()) @db.Uuid
  verificationCaseId String           @map("verification_case_id") @db.Uuid
  encryptedObjectKey String?          @map("encrypted_object_key") @db.VarChar(1000)
  note               String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  verificationCase   VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@map("farm_evidence")
}

model VerificationReview {
  id                 String           @id @default(uuid()) @db.Uuid
  verificationCaseId String           @map("verification_case_id") @db.Uuid
  reviewerAdminId    String           @map("reviewer_admin_id") @db.Uuid
  decision           ReviewDecision
  reason             String           @db.VarChar(500)
  internalNotes      String?          @map("internal_notes") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  verificationCase   VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Restrict)
  reviewer           AdminAccount     @relation(fields: [reviewerAdminId], references: [id], onDelete: Restrict)

  @@map("verification_reviews")
}

model AdminAccount {
  id                  String                @id @default(uuid()) @db.Uuid
  phoneE164           String                @unique @map("phone_e164")
  fullName            String                @map("full_name") @db.VarChar(120)
  status              AdminStatus           @default(INVITED)
  totpSecretEncrypted String?               @map("totp_secret_encrypted") @db.Text
  totpEnrolledAt      DateTime?             @map("totp_enrolled_at") @db.Timestamptz(6)
  invitedById         String?               @map("invited_by_id") @db.Uuid
  invitedAt           DateTime              @default(now()) @map("invited_at") @db.Timestamptz(6)
  lastLoginAt         DateTime?             @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions            Session[]
  roles               AdminRoleAssignment[]
  recoveryCodes       AdminRecoveryCode[]
  reviews             VerificationReview[]

  @@map("admin_accounts")
}

model AdminRole {
  id          String                @id @default(uuid()) @db.Uuid
  code        String                @unique @db.VarChar(80)
  name        String                @db.VarChar(120)
  assignments AdminRoleAssignment[]
  permissions RolePermission[]

  @@map("admin_roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String           @db.VarChar(240)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminRoleAssignment {
  adminId    String       @map("admin_id") @db.Uuid
  roleId     String       @map("role_id") @db.Uuid
  assignedAt DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role       AdminRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@map("admin_role_assignments")
}

model AdminRecoveryCode {
  id        String       @id @default(uuid()) @db.Uuid
  adminId   String       @map("admin_id") @db.Uuid
  codeHash  String       @map("code_hash") @db.Char(64)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, codeHash])
  @@map("admin_recovery_codes")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  actorType      String   @map("actor_type") @db.VarChar(30)
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(120)
  entityId       String?  @map("entity_id") @db.Uuid
  beforeRedacted Json?    @map("before_redacted")
  afterRedacted  Json?    @map("after_redacted")
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  requestId      String   @map("request_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Language {
  code       String  @id @db.VarChar(10)
  name       String  @db.VarChar(80)
  nativeName String  @map("native_name") @db.VarChar(80)
  isEnabled  Boolean @default(true) @map("is_enabled")
  sortOrder  Int     @map("sort_order")

  @@map("languages")
}

model Category {
  id           String                @id @default(uuid()) @db.Uuid
  slug         String                @unique @db.VarChar(100)
  isActive     Boolean               @default(true) @map("is_active")
  sortOrder    Int                   @default(0) @map("sort_order")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  translations CategoryTranslation[]
  listings     Listing[]

  @@map("categories")
}

model CategoryTranslation {
  categoryId String   @map("category_id") @db.Uuid
  locale     String   @db.VarChar(10)
  name       String   @db.VarChar(120)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model Unit {
  code          String    @id @db.VarChar(30)
  name          String    @db.VarChar(80)
  allowsDecimal Boolean   @default(true) @map("allows_decimal")
  isActive      Boolean   @default(true) @map("is_active")
  listings      Listing[]

  @@map("units")
}

model Listing {
  id                String                 @id @default(uuid()) @db.Uuid
  farmerProfileId   String                 @map("farmer_profile_id") @db.Uuid
  categoryId        String                 @map("category_id") @db.Uuid
  unitCode          String                 @map("unit_code") @db.VarChar(30)
  locationAddressId String                 @map("location_address_id") @db.Uuid
  title             String                 @db.VarChar(160)
  description       String?                @db.Text
  currencyCode      String                 @default("NGN") @map("currency_code") @db.Char(3)
  unitPriceMinor    BigInt                 @map("unit_price_minor")
  availableQuantity Decimal                @map("available_quantity") @db.Decimal(18, 3)
  reservedQuantity  Decimal                @default(0) @map("reserved_quantity") @db.Decimal(18, 3)
  shippingScope     ShippingScope          @map("shipping_scope")
  status            ListingStatus          @default(DRAFT)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz(6)
  farmerProfile     FarmerProfile          @relation(fields: [farmerProfileId], references: [id], onDelete: Restrict)
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit              Unit                   @relation(fields: [unitCode], references: [code], onDelete: Restrict)
  locationAddress   Address                @relation(fields: [locationAddressId], references: [id], onDelete: Restrict)
  media             ListingMedia[]
  movements         InventoryMovement[]
  reservations      InventoryReservation[]

  @@index([status, categoryId])
  @@index([farmerProfileId, status])
  @@map("listings")
}

model ListingMedia {
  id           String      @id @default(uuid()) @db.Uuid
  listingId    String      @map("listing_id") @db.Uuid
  type         MediaType
  objectKey    String      @map("object_key") @db.VarChar(500)
  mimeType     String      @map("mime_type") @db.VarChar(100)
  displayOrder Int         @default(0) @map("display_order")
  status       MediaStatus @default(PENDING)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  listing      Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, displayOrder])
  @@map("listing_media")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  listingId     String                @map("listing_id") @db.Uuid
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(18, 3)
  referenceType String?               @map("reference_type") @db.VarChar(40)
  referenceId   String?               @map("reference_id") @db.Uuid
  note          String?               @db.VarChar(500)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  listing       Listing               @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@map("inventory_movements")
}

model InventoryReservation {
  id                  String            @id @default(uuid()) @db.Uuid
  listingId           String            @map("listing_id") @db.Uuid
  checkoutReferenceId String            @map("checkout_reference_id") @db.Uuid
  quantity            Decimal           @db.Decimal(18, 3)
  status              ReservationStatus @default(ACTIVE)
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  listing             Listing           @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

/// Stores the result of retriable financial, order, inventory, and shipment mutations.
model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  scope          String    @db.VarChar(80)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  requestHash    String    @map("request_hash") @db.Char(64)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body") @db.JsonB
  resourceId     String?   @map("resource_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  @@unique([scope, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}
